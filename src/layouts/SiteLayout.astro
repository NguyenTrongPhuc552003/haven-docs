---
// Layout of the landing and CI pages: fixed thin header (logo, navigation,
// GitHub, theme toggle), content, footer. The documentation pages use
// Starlight with the same tokens (src/styles/starlight.css).
import "../styles/tokens.css";
import "../styles/site.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import logoLight from "../assets/logo-light.svg?url";
import logoDark from "../assets/logo-dark.svg?url";

interface Props {
	title: string;
	description: string;
	active?: "home" | "ci";
}
const { title, description, active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const u = (p: string) => `${base}${p}`;
const nav = [
	{ href: u("/haven/"), label: "HAVEN" },
	{ href: u("/elmos/"), label: "ELMOS" },
	{ href: u("/kdal/"), label: "KDAL" },
	{ href: u("/ci/"), label: "CI status", key: "ci" },
	{ href: u("/haven/records/try/"), label: "Try it" },
];
const gh = "https://github.com/NguyenTrongPhuc552003";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://docs-haven.vercel.app");
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={u("/favicon.ico")} sizes="32x32" />
		<link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="color-scheme" content="dark light" />
		<script is:inline>
			// Before first paint: stored choice, else the system preference.
			(() => {
				let t = null;
				try {
					t = localStorage.getItem("starlight-theme");
				} catch {}
				if (t !== "light" && t !== "dark")
					t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
				document.documentElement.dataset.theme = t;
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-header">
			<nav class="nav wrap" aria-label="Main">
				<a href={u("/")} class="brand" aria-label="HAVEN home">
					<img src={logoLight} alt="HAVEN" height="28" class="logo-light" />
					<img src={logoDark} alt="HAVEN" height="28" class="logo-dark" />
				</a>
				<ul class="nav-links">
					{nav.map((n) => (
						<li><a href={n.href} aria-current={n.key === active ? "page" : undefined}>{n.label}</a></li>
					))}
				</ul>
				<div class="nav-tools">
					<a class="icon-link" href={gh} aria-label="GitHub (NguyenTrongPhuc552003)" title="GitHub">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path></svg>
					</a>
					<ThemeToggle />
					<button type="button" class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
				</div>
			</nav>
			<div id="mobile-nav" class="mobile-nav" hidden>
				<ul class="wrap">
					{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
					<li><a href={gh}>GitHub</a></li>
				</ul>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-grid">
				<div>
					<img src={logoLight} alt="HAVEN" height="24" class="logo-light" />
					<img src={logoDark} alt="HAVEN" height="24" class="logo-dark" />
					<p class="muted small">
						A Master's thesis artifact, Computer Engineering, University of Information Technology (VNU-HCM).
						Research prototype: not for production use.
					</p>
				</div>
				<div>
					<h2 class="footer-h">Projects</h2>
					<ul class="footer-links">
						<li><a href={u("/haven/")}>HAVEN</a></li>
						<li><a href={u("/elmos/")}>ELMOS</a></li>
						<li><a href={u("/kdal/")}>KDAL</a></li>
					</ul>
				</div>
				<div>
					<h2 class="footer-h">Source</h2>
					<ul class="footer-links">
						<li><a href={`${gh}/haven`}>haven</a></li>
						<li><a href={`${gh}/elmos`}>elmos</a></li>
						<li><a href={`${gh}/kdal`}>kdal</a></li>
						<li><a href={`${gh}/haven-docs`}>haven-docs</a></li>
					</ul>
				</div>
				<div>
					<h2 class="footer-h">Project</h2>
					<ul class="footer-links">
						<li><a href={u("/ci/")}>CI status</a></li>
						<li><a href={u("/haven/roadmap/")}>Roadmap</a></li>
						<li><a href={u("/haven/records/related-work/")}>Related work</a></li>
						<li><a href={u("/haven/records/changelog/")}>Changelog</a></li>
					</ul>
				</div>
			</div>
			<div class="wrap footer-base muted small">Open source: HAVEN under Apache-2.0, ELMOS under MIT, KDAL under GPL-3.0.</div>
		</footer>

		<script>
			const btn = document.querySelector<HTMLButtonElement>(".menu-toggle");
			const menu = document.getElementById("mobile-nav");
			btn?.addEventListener("click", () => {
				const open = btn.getAttribute("aria-expanded") === "true";
				btn.setAttribute("aria-expanded", String(!open));
				btn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
				if (menu) menu.hidden = open;
			});
		</script>
	</body>
</html>
